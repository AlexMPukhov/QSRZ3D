# Blowout regime: dense narrow electron driver
grid.type   = uniform
grid.rmax   = 8.0
grid.dr     = 0.01
xi.min  = 0
xi.max  = 14
xi.step = 0.01
time.dt    = 0
time.steps = 0
pusher.ab_order = 4
plasma.species = electrons
electrons.ppc  = 4
beams = driver
driver.n0        = 10
driver.sigma_r   = 0.3
driver.sigma_xi  = 1.0
driver.xi0       = 3.0
driver.gamma     = 20000
driver.cut       = 4
driver.nparticles = 1000000
driver.rigid     = 1
output.dir   = out_blowout
output.every = 1
